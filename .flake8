[flake8]
# 帮扶管理信息系统 Python 代码风格配置（与 CI/pre-commit 一致）
max-line-length = 120
# 扩展选中：E/W(pycodestyle) F(pyflakes) B(bugbear) C4(comprehensions)
extend-select = E,W,F,B,C4
# 忽略：E203(切片空格，与 black 冲突) W503(换行运算符，与 black 冲突) E501(行长由 max-line-length+per-file 控制)
ignore = E203,W503,E501
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    artifacts,
    backend/build,
    scripts/archive,
# 测试文件允许 assert (S101)、魔术字面量等
per-file-ignores =
    tests/*:S101,B011
    */tests/*:S101,B011
    # 入口模块 app/main.py 必须在 import fastapi/uvicorn 之前执行裸调用
    # apply_windows_proactor_fix()（替换全局 EventLoopPolicy），这正是 E402 的
    # 判定点。pre-push 钩子从仓库根跑 backend/app/，故此处按根相对路径同步豁免
    # （与 backend/.flake8 的 app/main.py: E402 保持双口径一致）。
    backend/app/main.py:E402
# 复杂度与文档
# max-complexity 必须与 CI 一致：pr-checks.yml 的 lint 任务用 --max-complexity=16。
# 曾在此写 15 造成双口径——backend/app 下有 6 个函数正好是 16，过 CI 却过不了本
# 配置，从仓库根跑的 flake8（含 pre-push 钩子）在与 CI 不同的判据上变红，掩盖真实信号。
max-complexity = 16
docstring-convention = google
