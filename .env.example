# 帮扶管理信息系统 - 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# ==================== 基础配置 ====================
PROJECT_NAME=帮扶管理信息系统
PROJECT_VERSION=1.18.14
API_PREFIX=/api/v1
DEBUG=false
ENVIRONMENT=development

# ==================== 加密密钥配置 ====================
# ⚠️ 安全警告：生产环境必须修改默认密钥！
# 推荐使用加密存储来保护敏感密钥
# 1. 运行密钥迁移工具: python -m backend.app.utils.secret_migration
# 2. 启用加密密钥: USE_ENCRYPTED_SECRETS=true
# 3. 密钥将从 backend/secrets/encrypted_config.json 加载
USE_ENCRYPTED_SECRETS=false
SECRETS_FILE_PATH=./backend/secrets/encrypted_config.json
MASTER_KEY_PATH=./backend/secrets/master.key

# ⚠️⚠️⚠️ 严禁在 .env 中填入占位符或提交真实密钥 ⚠️⚠️⚠️
# 留空 = 由 backend/app/utils/runtime_secrets.py 自动生成并持久化到
#        backend/data/runtime_secrets.json（仅在文件 0o600 权限下安全）
# 推荐：生产环境使用 USE_ENCRYPTED_SECRETS=true 走加密文件加载
# ⚠️ 警告：不要在生产环境使用默认值！
# ⚠️ 警告：不要将实际密钥提交到版本控制系统！
# 注意：启用 USE_ENCRYPTED_SECRETS 后，这些值将被加密文件中的值覆盖
SECRET_KEY=
CSRF_SECRET_KEY=
ALGORITHM=HS256

# 通行码 HMAC 自验证密钥（跨机器/跨机注册，ADR-0004 / W1 不变量 #5）
#   - 单机部署（管理员与用户同一安装/同一数据库、仅本机回环访问）：可留空，
#     通行码走本机预录入路径。
#   - 多机 / 局域网 / 非回环（HOST=0.0.0.0 或经反向代理）部署：必须在【所有实例】
#     配置【同一】随机 PASS_CODE_SECRET（建议 ≥32 位随机字符），否则来自非本机
#     回环地址的自助注册/通行码自验证会被 fail-closed 拒绝（403），只能由管理员
#     在用户所在机器本机预录入通行码。
#   - 密钥一旦部署不可随意更换：更换后已签发的 HMAC 通行码全部失效，需重新签发。
# ⚠️ 警告：不要把真实密钥提交到版本控制！生产环境建议走 USE_ENCRYPTED_SECRETS 加密文件。
PASS_CODE_SECRET=

# ==================== R33 单位授权包签名（Ed25519） ====================
# 授权包用于「上级下发 → 下级导入」的单位模块授权矩阵，靠 Ed25519 签名防篡改。
#   - 上级（下发方）：配置 GRANT_SIGNING_KEY（32 字节 hex 私钥）签发授权包；
#     ⚠️ 私钥必须保密，不得提交版本库、不得下发给下级。
#   - 下级（接收方）：只配置 GRANT_PUBKEY（32 字节 hex 公钥）用于导入验签；
#     ⚠️ 未配置公钥时，导入任何带签名的授权包都会被拒绝（400：本机未配置验签公钥）。
#   - GRANT_ALLOW_UNSIGNED 必须永远保持 false：允许未签名包会彻底摧毁防篡改设计
#     （仅离线演练可临时开启）。
#   - GRANT_GUARD_MODE：R33 写收窄开关，默认 off（仅菜单裁剪生效）；可选 shadow（只记
#     日志）→ enforce（越权写 403）。生产建议先 shadow 观察再 enforce，不要直接默认 enforce。
# 生成密钥对（在 backend 目录执行；输出 hex 私钥/公钥，私钥只留在上级）：
#   .venv\Scripts\python.exe -c "from app.core.grant_signing import generate_keypair as g; k=g(); print('GRANT_SIGNING_KEY='+k[0]); print('GRANT_PUBKEY='+k[1])"
#   Linux: .venv/bin/python -c "...同上..."
GRANT_GUARD_MODE=off
GRANT_SIGNING_KEY=
GRANT_PUBKEY=
GRANT_ALLOW_UNSIGNED=false

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///./data/rural_revitalization.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false
SLOW_QUERY_THRESHOLD_MS=200.0

# ==================== 服务器配置 ====================
# ⚠️ 离线单机部署默认 127.0.0.1。多机网络部署才改为 0.0.0.0 + 防火墙策略
HOST=127.0.0.1
PORT=8000

# ==================== 缓存配置 ====================
CACHE_DIR=./data/cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=10000

# ==================== 安全配置 ====================
# token 有效期：军用安全基线要求 ≤8h（480 分钟）。代码默认 480；此处可按部署环境收窄。
# 结合 token_version 强制下线可进一步缓解会话泄露风险。
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_EXPIRE_DAYS=90
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ==================== CORS配置 ====================
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-Token

# ==================== CSRF配置 ====================
# 默认开启（军用安全基线）。前端 request.ts 自动获取并回填 X-CSRF-Token。
# 调试时可设为 false 临时关闭。
CSRF_ENABLED=true

# ==================== 速率限制 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FORMAT=json
LOG_ROTATION=10 days
LOG_RETENTION=30 days
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=5

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=xlsx,xls,csv,pdf,jpg,jpeg,png,doc,docx,pptx

# ==================== 监控配置 ====================
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

# ==================== 告警配置 ====================
# 邮件告警配置
ALERT_EMAIL_RECIPIENTS=admin@example.com,ops@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com

# Webhook告警配置
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alert
ALERT_WEBHOOK_TYPE=generic  # 可选: generic, dingtalk, wecom

# ==================== 数据库迁移配置 ====================
ENABLE_AUTO_MIGRATION=true

# ==================== 微前端配置 ====================
# 子应用入口地址（留空则使用默认 localhost 开发地址）
VITE_MICRO_USER_CENTER_URL=
VITE_MICRO_DATA_ANALYSIS_URL=
