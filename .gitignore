.scratch/**/*.json
.scratch/**/*.py
.scratch/**/*.js
.scratch/**/*.cjs
.scratch/**/*.sh
.scratch/**/.coverage*
.scratch/**/*.log
.scratch/**/*.db*
.scratch/**/r25-run/
