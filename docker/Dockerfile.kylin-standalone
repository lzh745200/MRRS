# ============================================================
# 帮扶管理信息系统 - 麒麟 V10 ARM64 一体化单机版
# 无 Electron，纯 FastAPI 后端 + 系统浏览器
# ============================================================
# 构建方式:
#   docker buildx build --platform linux/arm64 \
#     --build-arg VERSION=1.2.0 \
#     --target output \
#     -t assistance-management-kylin:1.2.0 \
#     -f docker/Dockerfile.kylin-standalone \
#     --output type=local,dest=dist/deb/kylin .
# ============================================================

# ── Stage 1: 构建前端 (Vue 3 + Vite) ──
# 基础镜像注册表（CI 可传 public.ecr.aws/docker 规避 Docker Hub 匿名限流；EOL buster 标签 ECR 全量保留）
ARG BASE_REGISTRY=docker.io/library

FROM --platform=linux/arm64 ${BASE_REGISTRY}/node:22-bookworm AS frontend-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /build

# 先复制依赖文件（利用 Docker 层缓存）
COPY frontend/package.json frontend/package-lock.json* ./frontend/
# postinstall 钩子（package.json）会执行 scripts/patch-vitest-coverage.cjs——只复制
# package.json 的层里该文件不存在 → MODULE_NOT_FOUND 使 npm install 直接失败
# （v1.11.5 ARM64 构建实测）。安装期就位脚本文件，补丁自身幂等（找到目标文件
# 才动，找不到仅告警），不破坏层缓存语义。
COPY frontend/scripts/patch-vitest-coverage.cjs ./frontend/scripts/
# 2026-10-28（v1.18.21）：容器内 npm install 加**三次退避重试**。
# 实测 v1.18.21 的 tag 构建 3 次尝试全部红在同一个位置：
#   `npm error network ... ECONNRESET` → "ERROR: npm install 失败 (exit code 1)"
# 而 workflow 的重试循环吞掉了失败（见 build-arm64.yml 的同批修复），
# 表现为「构建步骤 success 却没有产物」，下一步才炸 —— 极难定位。
# npm 自身 fetch-retries 对付不了连接重建，故外层再加退避。
RUN cd frontend \
 && npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 120000 \
 && npm config set fetch-timeout 300000 \
 && installed=0 \
 && for attempt in 1 2 3; do \
        echo "npm install attempt ${attempt}"; \
        if npm install --legacy-peer-deps --no-fund --no-audit --prefer-offline > /tmp/npm-install.log 2>&1; then \
            installed=1; break; \
        fi; \
        echo "npm install attempt ${attempt} failed:"; tail -20 /tmp/npm-install.log || true; \
        sleep $((attempt * 20)); \
    done; \
    if [ "${installed}" != "1" ]; then \
        echo "npm install 默认源连续失败，改用镜像 registry.npmmirror.com"; \
        if npm install --legacy-peer-deps --no-fund --no-audit \
             --registry "https://registry.npmmirror.com" --replace-registry-host=npm \
             > /tmp/npm-install.log 2>&1; then \
            installed=1; \
        fi; \
    fi; \
    if [ "${installed}" != "1" ]; then \
        echo "ERROR: npm install 连续 3 次失败（默认源与镜像均失败）"; \
        tail -30 /tmp/npm-install.log || true; \
        exit 1; \
    fi

# 复制前端源码并构建
COPY frontend/ ./frontend/
RUN cd frontend && npm run build > /tmp/npm-build.log 2>&1; \
    code=$?; tail -20 /tmp/npm-build.log; \
    if [ $code -ne 0 ]; then echo "ERROR: npm run build 失败 (exit code $code)"; exit 1; fi

# 验证构建产物
RUN test -f frontend/dist/index.html || (echo "ERROR: 前端构建失败，index.html 不存在" && exit 1)


# ── Stage 2: 构建后端 (PyInstaller ARM64) ──
# 关键：使用 buster (Debian 10, GLIBC 2.28) 而非 bookworm (GLIBC 2.36)
# 麒麟 V10 Server GLIBC=2.28, Desktop GLIBC=2.31
# PyInstaller 不打包 libc，二进制动态链接构建系统的 GLIBC
# 必须在最低 GLIBC 上构建以保证向前兼容（PyInstaller 官方文档要求）
ARG BASE_REGISTRY=docker.io/library
FROM --platform=linux/arm64 ${BASE_REGISTRY}/python:3.11-slim-buster AS backend-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# Buster 已 EOL，apt 源需重定向到 archive.debian.org
RUN echo "deb http://archive.debian.org/debian buster main" > /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian-security buster/updates main" >> /etc/apt/sources.list

# 安装编译依赖（ARM64 原生编译需要）
RUN apt-get update -o Acquire::Check-Valid-Until=false && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libmagic1 \
    libsqlite3-0 \
    libgomp1 \
    file \
    patchelf \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# 验证 GLIBC 版本（必须 <= 2.28 以兼容麒麟 V10）
RUN ldd --version | head -1 && \
    GLIBC_VER=$(ldd --version | head -1 | grep -oP '\d+\.\d+' | tail -1) && \
    echo "构建环境 GLIBC 版本: $GLIBC_VER" && \
    if [ "$(echo "$GLIBC_VER > 2.28" | bc)" = "1" ]; then \
        echo "ERROR: GLIBC 版本 $GLIBC_VER > 2.28，不兼容麒麟 V10！请检查 Docker 基础镜像。" && exit 1; \
    fi && \
    echo "OK: GLIBC 版本兼容麒麟 V10"

WORKDIR /build

# 生成 ARM64 专用 requirements（排除无 ARM64 wheel 或单机版不需要的包）
COPY backend/requirements.txt .
# v1.16.0（E 区 · ARM64 离线 OCR）：
#   ① 过滤正则**不再**剔除 rapidocr-onnxruntime / onnxruntime / opencv-python ——
#      2026-10-21 PyPI 实测 cp311/aarch64 全部有轮子（见 .scratch/offline-audit/
#      E-arm64-ocr-plan.md 的 wheel 清单）：onnxruntime 1.31.0
#      (manylinux_2_28_aarch64)、opencv cp37-abi3 manylinux2014_aarch64、
#      rapidocr-onnxruntime 1.4.4 (py3-none-any，ONNX 模型随 wheel)。
#      构建基座 buster 的 glibc 恰为 2.28，正好满足 manylinux_2_28 的 glibc>=2.28 前提
#      （Lead 实测 libonnxruntime.so 引用的最高符号版本 = GLIBC_2.28）。
#   ② 传递依赖的精确 pin 放在 requirements-arm64-ocr.txt。
COPY backend/requirements-arm64-ocr.txt .
RUN grep -v -E '^(prophet|cmdstanpy|stanio|scikit-learn|scipy|Scrapy|Twisted|matplotlib|redis|hiredis|selenium|python-magic-bin|pywin32-ctypes|Automat|constantly|hyperlink|incremental|itemadapter|itemloaders|parsel|Protego|PyDispatcher|queuelib|service-identity|sgmllib3k|tldextract|w3lib|zope|cssselect)' \
    requirements.txt > requirements-arm64.txt && \
    echo "python-magic==0.4.27" >> requirements-arm64.txt && \
    echo "--- ARM64 requirements ---" && \
    wc -l requirements-arm64.txt

# OCR 的**安装方式替换**（不是能力降级，OCR 在 ARM64 上已完整启用）：
# rapidocr-onnxruntime 的依赖名写死 opencv-python（非 headless 版，import 时会 dlopen
# libGL.so.1 / libglib-2.0.so.0）。离线麒麟机往往没有图形栈，也不该为 OCR 把原本
# "零外部依赖、dpkg -i 即装"的 standalone 包变成"缺 libgl1 就装不上"。
# 因此：从批量清单里摘出 rapidocr 这一行，改由下方 `pip install --no-deps` 单独安装，
# cv2 一律使用 opencv-python-headless 轮子。rapidocr 的其余依赖（onnxruntime /
# pyclipper / shapely / tqdm / numpy / pillow / PyYAML / six）全部显式 pin。
RUN grep -v -E '^rapidocr-onnxruntime' requirements-arm64.txt > requirements-arm64-base.txt && \
    echo "--- ARM64 base requirements（不含 OCR 引擎本体）---" && \
    wc -l requirements-arm64-base.txt && \
    echo "--- ARM64 OCR 追加段 ---" && \
    cat requirements-arm64-ocr.txt

# 安装 Python 依赖（使用默认 PyPI + 重试机制确保可靠性）
# 分三步：① 主依赖（含 numpy/pillow/pandas 等）② OCR 依赖（headless cv2 + onnxruntime
# + pyclipper/shapely/tqdm，正常解析依赖）③ OCR 引擎本体（--no-deps，避免 pip 拉回
# 非 headless 的 opencv-python）。
RUN pip install --retries 3 --timeout 120 \
    -r requirements-arm64-base.txt pyinstaller > /tmp/pip-install.log 2>&1; \
    code=$?; tail -20 /tmp/pip-install.log; \
    if [ $code -ne 0 ]; then echo "ERROR: pip install 失败 (exit code $code)"; exit 1; fi

RUN pip install --retries 3 --timeout 120 \
    -r requirements-arm64-ocr.txt > /tmp/pip-install-ocr.log 2>&1; \
    code=$?; tail -20 /tmp/pip-install-ocr.log; \
    if [ $code -ne 0 ]; then echo "ERROR: OCR 依赖安装失败 (exit code $code)"; exit 1; fi

RUN pip install --retries 3 --timeout 120 --no-deps \
    rapidocr-onnxruntime==1.4.4 > /tmp/pip-install-rapidocr.log 2>&1; \
    code=$?; tail -20 /tmp/pip-install-rapidocr.log; \
    if [ $code -ne 0 ]; then echo "ERROR: rapidocr 安装失败 (exit code $code)"; exit 1; fi && \
    echo "=== OCR 相关已安装发行包 ===" && \
    pip list 2>/dev/null | grep -iE "opencv|onnxruntime|rapidocr|pyclipper|shapely|tqdm|numpy|pillow" || true

# ── OCR 冒烟（E 区 · v1.16.0）：构建期证明 ARM64 离线 OCR 真正可用 ──
# 脚本放在仓库里（docker/ocr_smoke_arm64.py），不用 Dockerfile heredoc ——
# heredoc 需要 dockerfile frontend >=1.4，而本文件刻意不加 # syntax 指令
# （否则构建时要额外拉 docker/dockerfile 前端镜像，离线内网不可接受）。
# 脚本自身断言：未装非 headless opencv-python（--require-headless）、import cv2、
# RapidOCR() 实例化（onnxruntime 动态库 + ONNX 模型就位）、对合成图实际识别且含数字。
COPY docker/ocr_smoke_arm64.py /tmp/ocr_smoke_arm64.py
RUN python /tmp/ocr_smoke_arm64.py --require-headless > /tmp/ocr-smoke.log 2>&1; \
    code=$?; tail -40 /tmp/ocr-smoke.log; \
    if [ $code -ne 0 ]; then echo "ERROR: ARM64 OCR 冒烟失败（见上方日志）"; exit 1; fi

# 复制后端源码
COPY backend/ .

# 诊断：确认关键文件存在（避免 PyInstaller 因找不到文件而失败）
RUN echo "=== 诊断 alembic 目录 ===" && \
    ls -la alembic/ && \
    echo "=== 诊断 alembic.ini ===" && \
    test -f alembic.ini && echo "OK: alembic.ini 存在" || (echo "ERROR: alembic.ini 不存在" && exit 1) && \
    echo "=== 诊断 script.py.mako ===" && \
    test -f alembic/script.py.mako && echo "OK: script.py.mako 存在" || (echo "ERROR: script.py.mako 不存在" && exit 1) && \
    echo "=== 诊断 app 目录 ===" && \
    test -d app && echo "OK: app 目录存在" || (echo "ERROR: app 目录不存在" && exit 1) && \
    echo "=== 诊断 start.py ===" && \
    test -f start.py && echo "OK: start.py 存在" || (echo "ERROR: start.py 不存在" && exit 1) && \
    echo "=== 所有关键文件检查通过 ==="

# PyInstaller 打包
RUN pyinstaller --clean --noconfirm backend_linux_arm64_standalone.spec > /tmp/pyinstaller.log 2>&1; \
    code=$?; tail -30 /tmp/pyinstaller.log; \
    if [ $code -ne 0 ]; then echo "ERROR: PyInstaller 打包失败 (exit code $code)"; exit 1; fi

# 验证打包产物
RUN test -d dist/assistance-management-backend || (echo "ERROR: PyInstaller 打包失败" && exit 1) && \
    echo "=== 后端打包产物 ===" && \
    du -sh dist/assistance-management-backend && \
    echo "=== 验证 alembic 数据文件已打包 ===" && \
    (test -f dist/assistance-management-backend/alembic/script.py.mako && echo "OK: mako 模板已打包" || echo "WARN: mako 模板未找到") && \
    (test -f dist/assistance-management-backend/alembic.ini && echo "OK: alembic.ini 已打包" || echo "WARN: alembic.ini 未找到") && \
    echo "后端打包成功"

# 冻结产物 OCR 载荷断言（E 区 · v1.16.0）：
# spec 里的 collect_data_files('rapidocr_onnxruntime') / collect_dynamic_libs('onnxruntime')
# 带 find_spec 守卫 —— 一旦依赖装好了却被漏收（守卫判空、路径变更），
# 依赖在环境里存在但安装包里没有模型/动态库，运行期仍旧回落 503。
# 这里直接对 onedir 产物断言关键文件，把"打包漏收"拦在构建期。
RUN echo "=== 冻结产物 OCR 载荷断言 ===" && \
    MODELS=$(find dist/assistance-management-backend -path "*rapidocr_onnxruntime/models*" -name "*.onnx" | wc -l | tr -d ' ') && \
    echo "rapidocr ONNX 模型文件数: $MODELS" && \
    test "$MODELS" -ge 2 || (echo "ERROR: 冻结产物缺少 rapidocr ONNX 模型（datas 收集失效）" && exit 1) && \
    ORT=$(find dist/assistance-management-backend -name "onnxruntime_pybind11_state*" | wc -l | tr -d ' ') && \
    echo "onnxruntime 绑定库数: $ORT" && \
    test "$ORT" -ge 1 || (echo "ERROR: 冻结产物缺少 onnxruntime 绑定库（collect_dynamic_libs 失效）" && exit 1) && \
    CV2=$(find dist/assistance-management-backend -name "cv2*.so" | wc -l | tr -d ' ') && \
    echo "cv2 扩展模块数: $CV2" && \
    test "$CV2" -ge 1 || (echo "ERROR: 冻结产物缺少 cv2 扩展模块" && exit 1) && \
    echo "OK: 冻结产物 OCR 载荷齐全（模型 + onnxruntime 绑定 + cv2）"

# 关键验证：检查 PyInstaller 打包的 libpython3.11.so 不依赖高于 2.28 的 GLIBC
# 这是之前在麒麟 V10 上崩溃的根本原因
RUN echo "=== GLIBC 兼容性验证 ===" && \
    LIBPYTHON=$(find dist/assistance-management-backend -name "libpython3.*.so*" | head -1) && \
    if [ -z "$LIBPYTHON" ]; then echo "WARN: 未找到 libpython 共享库"; exit 0; fi && \
    echo "检查: $LIBPYTHON" && \
    MAX_GLIBC=$(objdump -T "$LIBPYTHON" 2>/dev/null | grep -oP 'GLIBC_\K\d+\.\d+' | sort -V | tail -1) && \
    echo "libpython 最高 GLIBC 要求: $MAX_GLIBC" && \
    if [ "$(echo "$MAX_GLIBC > 2.28" | bc)" = "1" ]; then \
        echo "ERROR: libpython 要求 GLIBC_$MAX_GLIBC > 2.28，不兼容麒麟 V10！" && exit 1; \
    fi && \
    echo "OK: libpython GLIBC 要求 <= 2.28，兼容麒麟 V10" && \
    echo "=== GLIBC 验证通过 ==="


# ── Stage 3: 组装 DEB 包 ──
ARG BASE_REGISTRY=docker.io/library
FROM --platform=linux/arm64 ${BASE_REGISTRY}/debian:buster-slim AS deb-package

ENV DEBIAN_FRONTEND=noninteractive

# Buster 已 EOL，apt 源需重定向到 archive.debian.org
RUN echo "deb http://archive.debian.org/debian buster main" > /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian-security buster/updates main" >> /etc/apt/sources.list

RUN apt-get update -o Acquire::Check-Valid-Until=false && apt-get install -y --no-install-recommends \
    dpkg-dev \
    fakeroot \
    && rm -rf /var/lib/apt/lists/*

ARG VERSION=1.18.24
WORKDIR /package

# 创建目录结构
RUN mkdir -p \
    opt/assistance-management-system/backend \
    opt/assistance-management-system/frontend \
    opt/assistance-management-system/config \
    opt/assistance-management-system/scripts \
    opt/assistance-management-system/systemd \
    opt/assistance-management-system/desktop \
    opt/assistance-management-system/polkit \
    opt/assistance-management-system/icons \
    usr/share/pixmaps \
    usr/share/icons/hicolor/512x512/apps \
    var/lib/assistance-management-system/database \
    var/lib/assistance-management-system/uploads \
    var/lib/assistance-management-system/exports \
    var/lib/assistance-management-system/cache \
    var/lib/assistance-management-system/backups \
    var/log/assistance-management-system \
    DEBIAN

# 复制构建产物
COPY --from=frontend-builder /build/frontend/dist/ ./opt/assistance-management-system/frontend/
COPY --from=backend-builder /build/dist/assistance-management-backend/ ./opt/assistance-management-system/backend/

# 复制部署配置
COPY deploy/kylin/config/kylin.env ./opt/assistance-management-system/config/
COPY deploy/kylin/scripts/start-kylin.sh ./opt/assistance-management-system/scripts/
COPY deploy/kylin/systemd/assistance-management-system.service ./opt/assistance-management-system/systemd/
COPY deploy/kylin/desktop/assistance-management-system.desktop ./opt/assistance-management-system/desktop/
COPY deploy/kylin/polkit/49-assistance-management-system.rules ./opt/assistance-management-system/polkit/

# 复制应用图标（桌面快捷方式与开始菜单图标使用）
COPY resources/icons/app-circle-256.png ./opt/assistance-management-system/icons/app-circle-256.png
# 同时安装到系统图标目录，供 .desktop 菜单项与桌面快捷方式引用
COPY resources/icons/app-circle-256.png ./usr/share/pixmaps/assistance-management-system.png
COPY resources/icons/app-circle-256.png ./usr/share/icons/hicolor/512x512/apps/assistance-management-system.png

# 复制 DEBIAN 控制脚本
COPY deploy/kylin/DEBIAN/postinst ./DEBIAN/
COPY deploy/kylin/DEBIAN/prerm ./DEBIAN/
COPY deploy/kylin/DEBIAN/postrm ./DEBIAN/

# 行尾规范化（治本）：维护脚本/服务/环境文件若混入 CRLF（Windows 检出构建时），
# `#!/bin/bash\r` 将无法执行 → dpkg postinst 失败 → 菜单/快捷方式/服务/数据目录全部缺失。
# 此处统一剥离 CR，保证 DEB 内容与构建环境无关。
RUN find DEBIAN opt/assistance-management-system/scripts opt/assistance-management-system/config \
        opt/assistance-management-system/systemd opt/assistance-management-system/desktop \
        opt/assistance-management-system/polkit -type f \
        -exec sed -i 's/\r$//' {} + && \
    chmod 755 DEBIAN/postinst DEBIAN/prerm DEBIAN/postrm && \
    chmod 755 opt/assistance-management-system/scripts/start-kylin.sh && \
    chmod 755 opt/assistance-management-system/backend/assistance-management-backend 2>/dev/null || true

# 生成 DEBIAN/control — 无外部依赖（完全自包含）
# v1.16.0（E 区 · ARM64 离线 OCR）复核结论：**仍然零外部依赖**，不要把 OCR 变成
# "离线机缺 libgl1 就装不上"的硬依赖：
#   - cv2 走 opencv-python-headless（见上方 OCR 依赖安装步骤），headless 轮子
#     不链接 libGL.so.1 / libglib-2.0.so.0 → 目标机无需图形栈；
#   - onnxruntime 1.31.0 aarch64 的 libonnxruntime.so 实测 DT_NEEDED 只有
#     libc/libdl/libgcc_s/libm/libpthread/librt/libstdc++，**不需要 libgomp**，
#     引用的最高 GLIBC 符号版本 = 2.28（正好等于麒麟 V10）；
#   - libmagic/libsqlite3 本来就打包进后端（见 spec 的 binaries 收集）。
# 故 Depends 保持为空；若未来换回非 headless opencv，必须在这里补 libgl1。
RUN echo "Package: assistance-management-system" > DEBIAN/control && \
    echo "Version: ${VERSION}" >> DEBIAN/control && \
    echo "Architecture: arm64" >> DEBIAN/control && \
    echo "Maintainer: Assistance Management Information Team" >> DEBIAN/control && \
    echo "Section: admin" >> DEBIAN/control && \
    echo "Priority: optional" >> DEBIAN/control && \
    echo "Installed-Size: $(du -sk opt/ | cut -f1)" >> DEBIAN/control && \
    echo "Depends: " >> DEBIAN/control && \
    echo "Recommends: firefox-esr | chromium | chromium-browser" >> DEBIAN/control && \
    echo "Description: 全面推进乡村振兴工作综合管理平台" >> DEBIAN/control && \
    echo " 完全单机版，适用于麒麟 V10 ARM64 系统。" >> DEBIAN/control && \
    echo " 集成村庄管理、项目跟踪、资金监管、数据分析等功能。" >> DEBIAN/control && \
    echo " 无外部依赖（Python 运行时/前端/离线 OCR 模型均已内置），安装即用。" >> DEBIAN/control

# 构建 DEB 包
RUN mkdir -p /output && \
    dpkg-deb --build --root-owner-group . /output/assistance-management-system_${VERSION}_arm64.deb && \
    echo "=== DEB 包构建完成 ===" && \
    ls -lh /output/*.deb && \
    echo "=== 验证 DEB 包结构 ===" && \
    dpkg-deb -I /output/assistance-management-system_${VERSION}_arm64.deb && \
    echo "=== 验证关键文件存在 ===" && \
    dpkg-deb -c /output/assistance-management-system_${VERSION}_arm64.deb | grep -E "assistance-management-backend$|start-kylin.sh|\.desktop|\.service|kylin.env|polkit" | head -10 && \
    echo "=== 验证图标与桌面快捷方式 ===" && \
    dpkg-deb -c /output/assistance-management-system_${VERSION}_arm64.deb | grep -E "icons/app-circle-256.png|usr/share/pixmaps/assistance|usr/share/icons/hicolor/512x512/apps/assistance" && \
    echo "=== DEB 包验证通过 ==="


# ── Stage 4: 输出层（仅导出 DEB 文件）──
FROM scratch AS output
COPY --from=deb-package /output/*.deb /output/


# ── Stage 5: ARM64 后端 onedir 产物（Electron DEB 复用）──
# 背景（v1.12.25）：此前 Electron DEB 由独立 build-backend 作业冷启动构建，需再次
# 拉取 python:3.11-slim-buster；Docker Hub / ECR 公共镜像匿名拉取配额耗尽时
# （toomanyrequests / Data limit exceeded）整条 ARM64 流水线失败，Release 丢失
# MRRS-Setup-*-arm64.deb。改为复用本 Dockerfile 的 backend-builder 缓存层导出，
# 与 standalone DEB 共享同一次 buildx 构建缓存，不再产生第二次冷拉取。
#
# v1.13.1 修复：backend-builder 的 PyInstaller 产物目录名来自
# backend_linux_arm64_standalone.spec 的 name = assistance-management-backend
# （见上面第 3 阶段 deb-package 的 COPY 源），此处曾误写成 assistance-backend，
# 导致 `--target backend-output` 每次都在 COPY 阶段失败（v1.12.25 与 v1.13.0
# ARM64 Electron DEB 缺失的直接根因）。
#
# v1.13.4 修复：产物目录导出名修正后，**主程序文件名**仍为
# assistance-management-backend（spec 的 EXE/COLLECT name），而 Electron Linux
# 主进程按 `resources/backend/assistance-backend/assistance-backend` 启动
# （electron/main.js exeName），workflow 也断言该文件名。scratch 阶段无法 RUN，
# 因此改为 debian-slim（buster 层已被 deb-package 阶段拉取，命中共缓存）并在
# 导出前重命名主程序；导出树仍为 dest/assistance-backend/assistance-backend。
# 注：BASE_REGISTRY 由文件前部（deb-package 阶段之前）的全局 ARG 提供，此处不重复声明。
FROM --platform=linux/arm64 ${BASE_REGISTRY}/debian:buster-slim AS backend-output
COPY --from=backend-builder /build/dist/assistance-management-backend /assistance-backend
RUN set -eux; \
    mv /assistance-backend/assistance-management-backend /assistance-backend/assistance-backend; \
    chmod +x /assistance-backend/assistance-backend; \
    test -x /assistance-backend/assistance-backend
